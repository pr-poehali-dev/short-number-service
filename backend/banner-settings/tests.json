{
  "tests": [
    {
      "name": "get_banner home section",
      "method": "POST",
      "path": "/",
      "body": {"_action": "get_banner", "section": "home"},
      "expectedStatus": 200,
      "expectedBody": {"type": "string"},
      "bodyMatcher": "partial"
    },
    {
      "name": "get_banner directory section",
      "method": "POST",
      "path": "/",
      "body": {"_action": "get_banner", "section": "directory"},
      "expectedStatus": 200,
      "bodyMatcher": "partial"
    },
    {
      "name": "update_banner without token returns 403",
      "method": "POST",
      "path": "/",
      "body": {"_action": "update_banner", "section": "home", "enabled": "true"},
      "expectedStatus": 403,
      "bodyMatcher": "partial"
    },
    {
      "name": "OPTIONS preflight",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    }
  ]
}
